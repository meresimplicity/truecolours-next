# Supabase application credentials. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side email webhook. Must honour the Idempotency-Key header.
INVOICE_EMAIL_WEBHOOK_URL=

PAINT_DATA_PROVIDER=open-data
MYCARCOLOR_API_KEY=
MYCARCOLOR_BASE_URL=https://api.mycarcolor.com/v1

# Server-side username alias; passwords are verified by Supabase Auth.
TRUECOLOURS_ADMIN_USERNAME=admin123
TRUECOLOURS_ADMIN_LOGIN_EMAIL=admin123@truecolours.internal

# Server-only Supabase secret key. Required only for temporary local admin access.
SUPABASE_SECRET_KEY=

# Local development only: automatically open the configured active admin account.
# This works only with NODE_ENV=development and same-origin localhost requests.
ADMIN_DEV_BYPASS=false
