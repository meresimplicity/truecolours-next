rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : 'customer';
    }

    function isStaff() {
      return role() in [
        'super_admin', 'owner', 'admin', 'administrator', 'staff', 'manager',
        'sales', 'salesperson', 'cashier', 'stock_controller', 'accountant'
      ];
    }

    function isSuperAdmin() {
      return role() in ['super_admin', 'owner'];
    }

    function isAdministrator() {
      return role() in ['super_admin', 'owner', 'admin', 'administrator'];
    }

    match /userProfiles/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow get, list: if isOwner(userId) || isStaff();
      allow update: if isAdministrator() || (
        isOwner(userId) && request.resource.data.role == resource.data.role
      );
      allow delete: if isSuperAdmin();

      // Covers all subcollections: vehicles, addresses, savedColours, cart,
      // favourites, notifications, recentlyViewed, downloads, onboarding, etc.
      match /{subcollection}/{documentId} {
        allow read, write: if isOwner(userId) || isAdministrator();
      }
    }

    match /quotes/{quoteId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'requested';
      allow get, list: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      // Orders affect money and stock. They are created through a validated,
      // idempotent server command rather than from browser-supplied totals.
      allow create: if false;
      allow get, list: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow get, list: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.direction == 'customer';
      allow get, list: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    match /managedProducts/{productId} {
      allow read: if true;
      // Product projections are updated by server services together with their
      // inventory movement/audit records.
      allow write: if false;
    }

    match /inventoryBalances/{balanceId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /inventoryReservations/{reservationId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Staff identity, role, location scope and session-version records are
    // canonical server data. They must never be writable from a browser SDK.
    match /staff/{staffId} {
      allow read, write: if false;
    }

    match /cms/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Counter documents used for sequential customer ID generation (TC000001, TC000002, …)
    match /counters/{counterId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // These financial and operational records must only be mutated by the
    // server command layer. Staff may read them from authorised tools.
    match /{collectionName}/{documentId} {
      allow read: if isStaff() && collectionName in [
        'sales', 'payments', 'paymentAttempts', 'returns', 'tillRegisters',
        'tillSessions', 'cashMovements', 'locations', 'stockCounts',
        'stockTransfers', 'stockBatches', 'suppliers', 'purchaseOrders',
        'goodsReceipts', 'devices', 'printers', 'webhookEvents',
        'idempotencyKeys'
      ];
      allow write: if false;
    }
  }
}
