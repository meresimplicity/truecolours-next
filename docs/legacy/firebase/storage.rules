rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ['super_admin', 'admin', 'staff', 'sales'];
    }

    match /customer-uploads/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaff());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if signedIn() && (request.auth.uid == userId || isStaff());
    }
  }
}
