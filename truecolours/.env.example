# --- Database -----------------------------------------------------------
# Postgres / Supabase connection string. Server-side only.
DATABASE_URL=postgres://user:password@localhost:5432/truecolours

# --- Vehicle taxonomy provider -------------------------------------------
# VehiclesDB (github.com/vehiclesdb/vehiclesdb) is CC-BY 4.0 and needs no
# key, but pin a release/commit so imports are reproducible. See README
# "Attribution" section — do not remove the attribution string it ships.
VEHICLESDB_RELEASE=latest

# --- Paint providers -------------------------------------------------------
# Never expose these to the browser. Only read them in server code
# (API routes, scripts) — see src/providers/*.
PAINT_CALCULATORS_API_KEY=
MYCARCOLOR_API_KEY=

# Feature flag: MyCarColor is documented here as "Public Beta". Leave this
# off until someone has actually read the current ToS/pricing and confirmed
# storage + redistribution rights, not just the marketing page. See
# src/providers/mycarcolor.provider.ts.
MYCARCOLOR_ENABLED=false

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000
NEXT_PUBLIC_SITE_NAME=TRUECOLOURS
